{
  "name": "17-313: Course Website",
  "image": "mcr.microsoft.com/devcontainers/base:debian",
  "postCreateCommand": "git submodule update --init --recursive && python3 -m pip install --break-system-packages -e './vendor/course.md[all]' 'mkdocs-material>=9.5.0' pre-commit",
  "customizations": {
    "vscode": {
      "extensions": [
        "davidanson.vscode-markdownlint",
        "tamasfe.even-better-toml",
        "mechatroner.rainbow-csv",
        "wholroyd.jinja",
        "ms-python.python",
        "james-yu.latex-workshop"
      ]
    }
  },
  "features": {
    "ghcr.io/christimperley/course.md/course-md:0.1.1": {
      "version": "85cb384",
      "slides": true,
      "ocr": true,
      "linters": true
    },
    "ghcr.io/rocker-org/devcontainer-features/quarto-cli:1": {
      "installChromium": false
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "remoteUser": "vscode"
}